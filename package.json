{
  "name": "openlinguo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --reporter=verbose",
    "e2e": "pnpm --filter @openlinguo/web e2e",
    "data:freshness": "pnpm --filter @openlinguo/data-pipeline freshness",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
