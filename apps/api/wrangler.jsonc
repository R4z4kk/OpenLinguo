// The cron Worker of the daily jobs. The API itself runs as Pages Functions (apps/web/functions).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openlinguo-jobs",
  "main": "src/cron.ts",
  "compatibility_date": "2026-10-19",
  "triggers": { "crons": ["17 3 * * *"] },
  // No public URL: the Worker has no fetch handler.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openlinguo",
      // Created with --jurisdiction=eu (ADR 0015); the same database as apps/web/wrangler.jsonc.
      "database_id": "3d2505dc-d634-4de5-b6f1-3ddbe9074d31",
      "migrations_dir": "migrations",
    },
  ],
}
