            },
            {
              "role": "user",
              "content": "{\"themes\":[\"Cooking\",\"Nature and hiking\"],\"note\":\"I like tea and hiking in the mountains.\"}"
            }
          ],
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "name": "answer",
              "strict": true,
              "schema": {
                "type": "object",
                "properties": {
                  "headwords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["headwords"],
                "additionalProperties": false
              }
            }
          }
        }
      },
